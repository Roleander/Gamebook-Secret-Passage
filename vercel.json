{
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma db push --skip-generate && prisma db seed && next build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "gamebook-secret-passage.vercel.app"
        }
      ],
      "destination": "https://www.gamebooksecret.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gamebook-secret-passage.vercel.app"
        }
      ],
      "destination": "https://www.gamebooksecret.com/:path*",
      "permanent": true
    }
  ]
}
