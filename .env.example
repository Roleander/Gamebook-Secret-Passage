# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/gamebook_secret_passage"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# Vercel Blob (for image uploads)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Stripe
STRIPE_SECRET_KEY="sk_live_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_SECRET="your-paypal-secret"

# Email (password reset, notifications) — multi-provider adapter
# EMAIL_PROVIDER="resend"            # resend (default) | brevo | postmark | mailgun
# EMAIL_FROM="Gamebook Secret Passage <no-reply@yourdomain.com>"
# EMAIL_API_KEY="your-api-key"
# EMAIL_API_URL=""                   # optional override (defaults per provider;
#                                    # e.g. EU Mailgun: https://api.eu.mailgun.net/v3/yourdomain.com/messages)

# AI (Groq or any OpenAI-compatible provider — optional, heuristics work without it)
# AI_API_KEY="gsk_..."
# AI_MODEL="llama-3.3-70b-versatile"
# AI_BASE_URL="https://api.groq.com/openai/v1"

# Public app URL (single source for hardcoded origins)
# NEXT_PUBLIC_APP_URL="https://gamebooksecret.com"
