{
  "manifest_version": 3,
  "name": "Gamebook Secret Passage",
  "version": "1.0.0",
  "description": "Guarda selecciones de texto directamente en tus proyectos de Gamebook.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.gamebooksecret.com/*",
    "https://gamebooksecret.com/*",
    "https://gamebook-secret-passage.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gamebook Secret Passage",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "secret-passage@gamebooksecret.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
